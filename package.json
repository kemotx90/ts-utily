{
  "name": "ts-utily",
  "version": "1.3.0",
  "description": "Typescript utils library",
  "homepage": "https://github.com/kemotx90/ts-utily#readme",
  "main": "dist/ts-utily.js",
  "types": "dist/ts-utily.d.ts",
  "type": "module",
  "files": [
    "/dist"
  ],
  "scripts": {
    "live:test": "npx jest --watch",
    "test": "npx jest --coverage",
    "build": "rimraf dist && tsc && rollup -c",
    "published": "npm publish",
    "git:publish": "git add . && git commit -m && git remote -v && git push origin main",
    "documentation": "typedoc"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node"
  },
  "keywords": [
    "typescript",
    "utils",
    "utility",
    "string",
    "number",
    "common",
    "collection",
    "conversion",
    "sort",
    "object",
    "date",
    "file",
    "angular utils",
    "react utils",
    "typescript utils"
  ],
  "author": "Piero Solinas & Daniele Carlini",
  "license": "MIT",
  "devDependencies": {
    "@rollup/plugin-terser": "^1.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.5.0",
    "jest": "^30.3.0",
    "rimraf": "^6.1.3",
    "rollup": "^4.59.0",
    "rollup-plugin-typescript2": "^0.36.0",
    "ts-jest": "^29.4.6",
    "typedoc": "^0.28.17",
    "typedoc-plugin-markdown": "^4.10.0",
    "typescript": "^5.9.3"
  }
}
